class Solution {
public:
    string removeOuterParentheses(string s) {
        string ans;
        int start=0;
        int fir=0;
        for(int i=0;i<s.length();i++)
        {
            //cout<<fir;
            if(s[i]=='(')
            {
                if(fir==0)
                {
                    start=i;
                }

                fir++;
                
                
            }
            else
            {
                fir--;
            }
            if(fir==0)
            {
                ans+=s.substr(start+1,i-start-1);
            }
        }
        return ans;
    }
};
