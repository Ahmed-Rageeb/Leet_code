/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    int i;
    TreeNode* tree(vector<int>& inorder, unordered_map<int,int> &m,vector<int>& postorder, int l,int r)
    {
        if(l>r)
        {
            return NULL;
        }
        int val=postorder[i];
        i--;
        int index=m[val];
        TreeNode* root= new TreeNode(val);
        root->right=tree(inorder,m,postorder,index+1,r);
        root->left=tree(inorder,m,postorder,l,index-1);
        return root;
    }
    TreeNode* buildTree(vector<int>& inorder, vector<int>& postorder) {
        i=inorder.size()-1;
        unordered_map<int,int> m;
        for(int i=0;i<inorder.size();i++)
        {
            m[inorder[i]]=i;
        }
        return tree(inorder,m,postorder,0,inorder.size()-1);
    }
};
