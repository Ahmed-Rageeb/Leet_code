class Solution {
public:
    long long dp(string &s, string &t, vector<vector<long long>>& visit, int index,string temp)
    {
        if(temp==t)
        {
            return 1;
        }
        if(index>=s.length())
        {
            return 0;
        }
        int j=temp.length();
        if(visit[index][j]!=-1)
        {
            return visit[index][j];
        }
        long long take=0;
        if(j<t.length() && s[index]==t[j])
        {
            take=dp(s,t,visit,index+1,temp+s[index]);
        }
        
        long long skip=dp(s,t,visit,index+1,temp);
        visit[index][j]=take+skip;
        return visit[index][j];
        
    }
    int numDistinct(string s, string t) {
        vector<vector<long long>>visit(s.length(),vector<long long>(t.length(),-1));
        return dp(s,t,visit,0,"");
        
    }
};
