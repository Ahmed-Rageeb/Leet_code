class Solution {
public:
    string reverseParentheses(string s) {
        stack<string>st;
        
        for(int i=0;i<s.length();i++)
        {
            if(s[i]=='(')
            {
                st.push(string(1,s[i]));
            }
            else if(s[i]==')')
            {
                string temp="";
                while(!st.empty() && st.top()!="(")
                {
                    if(st.top().length()>1)
                    {
                         reverse(st.top().begin(),st.top().end());
                         temp+=st.top();
                    }
                    else
                    {
                        temp+=st.top();
                    }
                    
                    st.pop();
                }
                st.pop();
                st.push(temp);
            }
            else
            {
                st.push(string(1,s[i]));
            }
        }
        string ans;
        while(!st.empty())
        {
            ans=st.top()+ans;
            st.pop();
        }
        return ans;
    }
};
