class Solution {
public:
    int closedIsland(vector<vector<int>>& grid) {
      vector<vector<int>>visit(grid.size(),vector<int>(grid[0].size(),-1));
      int count=0;
      for(int i=0;i<grid.size();i++)
      {
        for(int j=0;j<grid[i].size();j++)
        {
            if(grid[i][j]==0 && visit[i][j]==-1 && bfs(i,j,grid.size(),grid[0].size(),visit,grid))
            {
                count++;
            }
        }
      }
      return count;
    }
    bool bfs(int i,int j, int r,int c,vector<vector<int>>&visit,vector<vector<int>>& grid)
    {
        queue<pair<int,int>>q;
        q.push({i,j});
        visit[i][j]=1;
        bool island=true;
        vector<int>dx={0,1,0,-1};
        vector<int>dy={1,0,-1,0};
        while(!q.empty())
        {
            auto a=q.front();
            q.pop();
            for(int i=0;i<4;i++)
            {
                int x=a.first+dx[i];
                int y=a.second+dy[i];
                if(x<0 || x>=r || y<0|| y>=c)
                {
                    island=false;
                }
                else
                {
                    if(grid[x][y]==0 && visit[x][y]==-1)
                    {
                        q.push({x,y});
                        visit[x][y]=1;
                    }
                }
            }
        }
        return island;
    }
};
