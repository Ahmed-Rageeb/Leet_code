class Solution {
public:
    int minInsertions(string s) {
        stack<char>st;
        int ans=0;
        for(int i=0;i<s.length();i++)
        {
            if(s[i]=='(')
            {
                st.push(s[i]);
            }
            else
            {
                if(st.empty())
                {
                    ans++;
                }
                else
                {
                    st.pop();
                }
                if(s[i+1]==')')
                {
                    i=i+1;
                }
                else
                {
                    ans++;
                }
            }
        }
        return ans+=st.size()*2;
    }
};
