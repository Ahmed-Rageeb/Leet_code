class Solution {
public:
    int maxDepth(string s) {
        int maxi=0;
        int current=0;
        for(int i=0;i<s.length();i++)
        {
            if(s[i]=='(')
            {
                current++;
            }
            else if(s[i]==')')
            {
                maxi=max(current,maxi);
                current--;
            }
        }
        return maxi;
    }
};
