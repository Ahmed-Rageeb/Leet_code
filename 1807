class Solution {
public:
    string evaluate(string s, vector<vector<string>>& knowledge) {
        unordered_map<string,string>m;
        for(int i=0;i<knowledge.size();i++)
        {
            m[knowledge[i][0]]=knowledge[i][1];
        }
        string ans;
        for(int i=0;i<s.length();i++)
        {
            if(s[i]=='(')
            {
                int j=i;
                j++;
                string temp;
                while(s[j]!=')')
                {
                    temp+=s[j];
                    j++;
                }
                if(m.find(temp)!=m.end())
                {
                    auto it=m.find(temp);
                    ans+=it->second;
                }
                else
                {
                    ans+='?';
                }
                i=j;
            }
            else
            {
                ans+=s[i];
            }
        }

        return ans;
    }
};
