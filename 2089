class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
        sort(nums.begin(),nums.end());
        vector<int>ans;
        int left=0;
        int right=nums.size()-1;
        int first=-1;
        while(left<=right)
        {
            int mid = left + (right - left) / 2;
            if(nums[mid]==target)
            {
                first=mid;
                right = mid - 1;
            }
            else if(nums[mid]>target)
            {
                
                right=mid-1;
            }
            else
            {
                left=mid+1;
            }
        }
        if(first!=-1)
        {
            while(first<nums.size() && nums[first]==target)
            {
                ans.push_back(first);
                first++;
            }
        }
        return ans;
    }
};
