class Solution {
public:
    bool hasValidPath(vector<vector<char>>& grid) {
        stack<pair<int,pair<int,int>>>st;
        int r=grid.size();
        int c=grid[0].size();
        int length = r + c - 1;
        vector<vector<vector<int>>>visit(r,vector<vector<int>>(c,vector<int>(length+1,-1)));
        int temp=0;
        if(grid[0][0]=='(')
        {
            temp=1;
        }
        else
        {
            return false;
        }

        st.push({temp,{0,0}});
        visit[0][0][temp]=1;
        vector<pair<int,int>>dir={{0,1},{1,0}};
        while(!st.empty())
        {
            auto t=st.top();
            st.pop();
            int ro=t.second.first;
            int co=t.second.second;
            if(ro==r-1 && co==c-1)
            {
                if(t.first==0)
                {
                    return true;
                }
                continue;
            }
            if(t.first>=0)
            {
                for(auto [x,y]:dir)
                {
                    if(ro+x>=0 && ro+x<r && co+y>=0 && co+y<c)
                    {
                        if(grid[ro+x][co+y]=='(')
                        {
                            temp=t.first+1;
                        }
                        else
                        {
                            temp=t.first-1;
                        }
                        if(temp<0)
                        {
                            continue;
                        }
                        if(visit[ro+x][co+y][temp]!=-1)
                        {
                            continue;
                        }                       
                        st.push({temp,{ro+x,co+y}});
                        visit[ro+x][co+y][temp]=1;
                    }
                }
            }
        }

        return false;

    }
};
