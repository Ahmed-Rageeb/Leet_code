class Solution {
public:
    int today(string s,vector<int>pre)
    {
        int m=stoi(s.substr(0,2));
        m=m-1;
        int d=stoi(s.substr(3));
        return (m == 0 ? 0 : pre[m-1]) + d;
    }
    int countDaysTogether(string arriveAlice, string leaveAlice, string arriveBob, string leaveBob) {
        vector<int>month={31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        vector<int>pre(month.size(),0);
        pre[0]=month[0];
        for(int i=1;i<month.size();i++)
        {
            pre[i]=pre[i-1]+month[i];
        }
        int arr1=today(arriveAlice,pre);
        int dep1=today(leaveAlice,pre);
        int arr2=today(arriveBob,pre);
        int dep2=today(leaveBob,pre);  
        int date=(min(dep1,dep2)-max(arr1,arr2))+1;
        return date > 0 ? date : 0;
    }
};
