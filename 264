class Solution {
public:
    int nthUglyNumber(int n) {
        set<long long>s;
        s.insert(1);
        long long temp=1;
        for(int i=0;i<n;i++)
        {
            temp=*s.begin();
            s.erase(s.begin());        
            s.insert(temp*2);
            s.insert(temp*3);
            s.insert(temp*5);
        }
        return int(temp);
    }
};
