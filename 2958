class Solution {
public:
    int maxSubarrayLength(vector<int>& nums, int k) {
        map<int,int>m;
        int len=0;
        int ans=0;
        int l=0;
        for(int i=0;i<nums.size();i++)
        {
            m[nums[i]]++;
            
            while(m[nums[i]]>k)
            {
                m[nums[l]]--;
                l++;
            }
                
            
            ans=max(ans,i-l+1);
        }
        return ans;
    }
};
