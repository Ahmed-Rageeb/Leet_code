class Solution {
public:
    int missingInteger(vector<int>& nums) {
        map<int,int>m;
        int sum=nums[0];       
        for(int i=1;i<nums.size();i++)
        {
            if(nums[i-1]+1==nums[i])
            {
                sum+=nums[i];
                
            }
            else
            {
                break;
            }
        }
        for(int i=0;i<nums.size();i++)
        {
            m[nums[i]]++;
        }
        while(m.find(sum)!=m.end())
        {
            sum++;
        }
        return sum;
    }
};
