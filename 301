class Solution {
public:
    set<string>se;
    int len;
    int minAddToMakeValid(string s) {
        int open=0;
        int count=0;
        int re=0;
        for(int i=0;i<s.length();i++)
        {
            if(s[i]=='(')
            {
                open++;
            }
            else if(s[i]==')')
            {
                if(open>0)
                {
                    open--;
                }
                else
                {
                    re++;
                }
                
            }
        }
        return open+re;
    }
    void visit(int i,string temp,string &s)
    {
        
        if(temp.length()==len)
        {
            if(minAddToMakeValid(temp)==0)
            {
                se.insert(temp);
            }
            return;
        }
        if(i>=s.length())
        {
            return;
        }
        if(s[i]=='(' || s[i]==')')
        {
            visit(i+1,temp+s[i],s);
            visit(i+1,temp,s);
        }
        else
        {
            visit(i+1,temp+s[i],s);
        }
    }
    vector<string> removeInvalidParentheses(string s) {
         int limit=minAddToMakeValid(s);
         len=s.length() - limit;
         visit(0,"",s);
         vector<string>ans;
         for(string a:se)
         {
            ans.push_back(a);
         }
         return ans;
    }
};
