class Solution {
public:
    int minimumPushes(string word) {
        vector<int>map(26,0);
        for(int i=0;i<word.length();i++)
        {
            map[word[i]-'a']++;
        }
        sort(map.begin(),map.end(),[](int a,int b)
            {
                return a>b;
            }
        
        );
        int count=0;
        for(int i=0;i<26;i++)
        {
            count+=(i/8+1)*map[i];
        }
        return count;
    }
};
