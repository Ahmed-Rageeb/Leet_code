class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int left=0,right=nums.size()-1;
        bool find=false;
        int last=0;
        while(left<=right)
        {
            int mid=left+(right-left)/2;
            if(nums[mid]==target)
            {
                find=true;
                last=mid;
                left=mid+1;
            }
            else if(target>nums[mid])
            {
                left=mid+1;
            }
            else
            {
                right=mid-1;
            }
        }
        if(!find)
        {
            return {-1,-1};
        }

        left=0;
        right=nums.size()-1;
        int first=0;
        while(left<=right)
        {
            int mid=left+(right-left)/2;
            if(nums[mid]==target)
            {
                first=mid;
                right=mid-1;
            }
            else if(target<nums[mid])
            {
               right=mid-1;
            }
            else
            {
                 left=mid+1;
                
            }
        }
        return {first,last};
        
    }
};
