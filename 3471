class Solution {
public:
    int largestInteger(vector<int>& nums, int k) {

        map<int,int>m;
        int maxi=INT_MIN;
        if(k==nums.size())
        {
            return *max_element(nums.begin(),nums.end());
        }
        for(int i=0;i<nums.size();i++)
        {
            m[nums[i]]++;
            maxi=max(maxi,nums[i]);
        }
        if(k==1)
        {
            int maxi=-1;

            for(auto [x,freq]:m)
            {
                if(freq==1)
                {
                    maxi=max(maxi,x);
                }
            }
            return maxi;
        }

        else
        {
            if(nums[0]>nums[nums.size()-1])
            {
                if(m[nums[0]]<2)
                {
                    return nums[0];
                }
                else if(m[nums[nums.size()-1]]<2)
                {
                    return nums[nums.size()-1];
                }
                else 
                {
                    return -1;
                }
            }

            else
            {
                if(m[nums[nums.size()-1]]<2)
                {
                    return nums[nums.size()-1];
                }
  
                else if(m[nums[0]]<2)
                {
                    return nums[0];
                }
                
                else 
                {
                    return -1;
                }
            }
        }
        
    }
};
