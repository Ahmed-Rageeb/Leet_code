class Solution {
public:
    int maxProduct(int n) {
        string temp=to_string(n);
        int max1=INT_MIN;
        int max2=INT_MIN;
        for(int i=0;i<temp.size();i++)
        {
            if(temp[i]-'0'>=max1)
            {
                max2=max1;
                max1=temp[i]-'0';
                cout<<max2<<max1<<endl;
            }
            else if(temp[i]-'0'>=max2)
            {
                max2=temp[i]-'0';
            }
            //cout<<temp[i]<<endl;
        }
        return max2*max1;
        
    }
};
