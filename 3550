class Solution {
public:
    int smallestIndex(vector<int>& nums) {
        for(int i=0;i<nums.size();i++)
        {
            string temp=to_string(nums[i]);
            int tempnum=0;
            for (int i=0;i<temp.length();i++)
            {
                tempnum+=temp[i]-'0';
                //cout<<tempnum;
            }
            if(tempnum==i)
            {
                return i;
            }
        }
        return -1;
    }
};
