class Solution {
public:
    vector<int> findMissingElements(vector<int>& nums) {
        map<int,int>m;
        int max=INT_MIN;
        int min=INT_MAX;
        for(int i=0;i<nums.size();i++)
        {
            m[nums[i]]++;
            if(nums[i]>max)
            {
                max=nums[i];
            }
            if(nums[i]<min)
            {
                min=nums[i];
            }
        }
        vector<int>ans;
        for(int i=min;i<=max;i++)
        {
            if(m.find(i)==m.end())
            {
                ans.push_back(i);
            }
        }
        return ans;
        
    }
};
