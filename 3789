class Solution {
public:
    long long minimumCost(int cost1, int cost2, int costBoth, int need1, int need2) {

        long long res=0;
        if(cost1+cost2<=costBoth)
        {
            res+= 1LL * need1*cost1+ 1LL * need2*cost2;
        }
        else
        {
            res+=1LL * min(need1,need2)*costBoth;
            if(need1-min(need1,need2)>0)
            {
                res+= 1LL * (need1-min(need1,need2))*min(cost1,costBoth);
            }
            else
            {
                res+= 1LL * (need2-min(need1,need2))*min(cost2,costBoth);
            }
        }
        return res;
    }
};
