class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        int min=INT_MAX;
        int even=0;
        for(int i=0;i<nums1.size();i++)
        {
            if(nums1[i]<min)
            {
                min=nums1[i];
            }
            if(nums1[i]%2==0)
            {
                even++;
            }
        }
        //cout<<even<<" "<<min;
        if(min%2!=0)
        {
            return true;
        }
        else
        {
            
            if(even==nums1.size())
            {
                return true;
            }
            return false;
        }
    }
};
