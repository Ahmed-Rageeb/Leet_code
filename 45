class Solution {
public:
    int dp(vector<int>& nums,vector<int>& visit,int i)
    {
        if(i>=nums.size())
        {
            return INT_MAX;
        }
        if(i==nums.size()-1)
        {
            return 0;
        }
        if(visit[i]!=-1)
        {
            return visit[i];
        }
        int mini=INT_MAX;
        for(int j=1;j<=nums[i];j++)
        {
            int temp=dp(nums,visit,i+j);
            if(temp!=INT_MAX)
            {
                mini=min(mini,1+temp);
            }
            
        }
        visit[i]=mini;
        return mini;
    }
    int jump(vector<int>& nums) {
        vector<int>visit(nums.size(),-1);
        return dp(nums,visit,0);
    }
};
